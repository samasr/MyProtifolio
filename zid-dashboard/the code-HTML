    <div class="flag-row"><div class="flag-issue" contenteditable="true">Add-to-cart but no checkout</div><div class="flag-action" contenteditable="true">Payment method issue — check settings</div></div>
    <div class="flag-row" style="border:none;"><div class="flag-issue" contenteditable="true">Return requests in first week</div><div class="flag-action" contenteditable="true">Product description mismatch — fix immediately</div></div>
