<div class="toast" id="toast"></div>

<script>
/* ── STORAGE ── */
const KEY = 'store_dash_v3';
function load() { try { return JSON.parse(localStorage.getItem(KEY)) || {}; } catch(e) { return {}; } }
function save() { localStorage.setItem(KEY, JSON.stringify(S)); }

let S = load();

/* ── TOAST ── */
function toast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2400);
}

/* ── COPY LINK ── */
function copyLink() {
  navigator.clipboard.writeText(window.location.href.split('?')[0])
    .then(() => toast('Link copied to clipboard!'));
}

/* ── SETUP ── */
function updateLogoPreview() {
  const v = document.getElementById('s-name').value.trim();
  document.getElementById('setup-logo-mark').textContent = v ? v.slice(0,2).toUpperCase() : 'ST';
}

function completeSetup() {
  const name   = document.getElementById('s-name').value.trim() || 'My Store';
  const type   = document.getElementById('s-type').value.trim() || 'Products · Launch Dashboard';
  const budget = parseFloat(document.getElementById('s-budget').value) || 0;
  const date   = document.getElementById('s-date').value || '';
  const aov    = parseFloat(document.getElementById('s-aov').value) || 0;
  const profit = parseFloat(document.getElementById('s-profit').value) || 0;

  S.storeName = name;
  S.storeSub  = type;
  S.budget    = budget;
  S.launchDate= date;
  S.aov       = aov;
  S.profitPer = profit;
  S.setupDone = true;
  save();
  document.getElementById('setup-modal').classList.add('hidden');
  applyState();
}

/* ── APPLY STATE TO DOM ── */
function applyState() {
  setText('store-name', S.storeName || 'Your Store');
  setText('store-sub',  S.storeSub  || 'Launch Command Center');
  setLogoMark();
  updateDaysCounter();
  renderKPIs();
  renderCompare();
  renderPhaseProgress();
  renderDonut();
  renderDays();
  renderProducts();
  renderBundles();
  restoreEditables();
  restoreMilestones();
  updateROIInputs();
  calcROI();
}

function setText(id, val) {
  const el = document.getElementById(id);
  if (el && val) el.textContent = val;
}

function setLogoMark() {
  const name = S.storeName || 'ST';
  const mark = name.trim().slice(0,2).toUpperCase();
  const el = document.getElementById('logo-mark');
  if (el) el.textContent = mark;
  document.title = (S.storeName || 'Store') + ' Launch Dashboard';
}

/* ── DAYS COUNTER ── */
function updateDaysCounter() {
  if (!S.launchDate) return;
  const now  = new Date(); now.setHours(0,0,0,0);
  const tgt  = new Date(S.launchDate);
  const diff = Math.ceil((tgt - now) / 86400000);
  document.getElementById('days-left').textContent = diff > 0 ? diff : 0;
}

/* ── TAB SWITCHING ── */
function switchTab(name, btn) {
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('tab-' + name).classList.add('active');
  btn.classList.add('active');
  if (name === 'roi') { setTimeout(calcROI, 50); setTimeout(buildROIChart, 80); }
}

/* ── EDIT MODE ── */
function toggleEditMode() {
  document.body.classList.toggle('edit-mode');
  const on = document.body.classList.contains('edit-mode');
  document.getElementById('edit-btn').textContent = on ? '✓ Done Editing' : '✏ Edit Mode';
  if (!on) toast('Changes saved ✓');
}

/* ── EDITABLE FIELDS ── */
function saveEditable(key, el) {
  S[key] = el.textContent.trim();
  save();
  if (key === 'storeName') setLogoMark();
}

function restoreEditables() {
  const map = {
    'store-name':'storeName','store-sub':'storeSub',
    'col-old':'colOld','col-new':'colNew',
    't_visitors':'t_visitors','t_cart':'t_cart','t_cvr':'t_cvr','t_aov':'t_aov',
    'm_visitors':'m_visitors','m_cart':'m_cart','m_cvr':'m_cvr','m_aov':'m_aov',
  };
  Object.entries(map).forEach(([id, key]) => {
    if (S[key]) { const el = document.getElementById(id); if (el) el.textContent = S[key]; }
  });
  // phase done banners
  ['p0','p1','p2','p3'].forEach((k,i) => {
    if (S[k]) {
      const els = document.querySelectorAll('[onblur*="savePhaseDone"]');
      if (els[i]) els[i].textContent = S[k];
    }
  });
}

function savePhaseDone(idx, el) {
  S['p'+idx] = el.textContent.trim();
  save();
}

/* ── KPI CARDS ── */
const KPI_DEFS = [
  { key:'kpi_products', label:'Products',        sub:'in your store',      accent:'#1a1917', default:'—' },
  { key:'kpi_days',     label:'Days to launch',  sub:'target date',        accent:'#9b2226', default:'—' },
  { key:'kpi_budget',   label:'Marketing budget',sub:'SAR campaign budget', accent:'#7b5e1a', default:'—' },
  { key:'kpi_profit',   label:'Projected profit',sub:'SAR monthly target',  accent:'#2d6a4f', default:'—' },
  { key:'kpi_phases',   label:'Phases done',     sub:'of 4 phases',         accent:'#1a4b7c', default:'0/4'},
];

function renderKPIs() {
  const grid = document.getElementById('kpi-grid');
  grid.innerHTML = KPI_DEFS.map(k => {
    const val = S[k.key] !== undefined ? S[k.key] : k.default;
    return `<div class="kpi-card">
      <div class="kpi-accent" style="background:${k.accent};"></div>
      <div class="kpi-label">${k.label}</div>
      <div class="kpi-value" contenteditable="true" onblur="saveEditable('${k.key}',this)">${val}</div>
      <div class="kpi-sub">${k.sub}</div>
    </div>`;
  }).join('');
  // auto-fill budget from setup
  if (S.budget && !S.kpi_budget) {
    document.querySelector('[onblur*="kpi_budget"]').textContent = S.budget.toLocaleString();
  }
}

/* ── COMPARE TABLE ── */
const COMPARE_DEFAULTS = [
  ['Fees per sale','—','—'],
  ['Brand ownership','—','—'],
  ['Customer data','—','—'],
  ['Profit per unit','—','—'],
];

function renderCompare() {
  const rows = S.compareRows || COMPARE_DEFAULTS;
  document.getElementById('col-old').textContent = S.colOld || 'Previous Platform';
  document.getElementById('col-new').textContent = S.colNew || 'Your Store';
  document.getElementById('compare-rows').innerHTML = rows.map((r, i) => `
    <div class="compare-row">
      <div class="compare-cell" contenteditable="true" onblur="saveCompare(${i},0,this)">${r[0]}</div>
      <div class="compare-cell bad"  style="text-align:center;" contenteditable="true" onblur="saveCompare(${i},1,this)">${r[1]}</div>
      <div class="compare-cell good" style="text-align:center;" contenteditable="true" onblur="saveCompare(${i},2,this)">${r[2]}</div>
    </div>`).join('');
}

function saveCompare(row, col, el) {
  if (!S.compareRows) S.compareRows = JSON.parse(JSON.stringify(COMPARE_DEFAULTS));
  S.compareRows[row][col] = el.textContent.trim();
  save();
}

/* ── PHASE PROGRESS ── */
const PHASE_LABELS = [
  'Phase 1 — Preparation',
  'Phase 2 — Store setup',
  'Phase 3 — Products & content',
  'Phase 4 — Launch & track',
];
const PHASE_BADGES = ['Done','Done','In progress','Pending'];
const PHASE_COLORS = ['var(--green)','var(--green)','#e9c46a','var(--green)'];

function renderPhaseProgress() {
  const p3Tasks = (S.tasks || {});
  const phase3Ids = ['sun','mon','tue','wed','thu'].flatMap(d => ((p3Tasks[d]||[]).map((_,i)=>d+'_'+i)));
  const phase4Ids = ['fri','sat'].flatMap(d => ((p3Tasks[d]||[]).map((_,i)=>d+'_'+i)));
  const p3done = phase3Ids.filter(k => S['task_'+k]).length;
  const p4done = phase4Ids.filter(k => S['task_'+k]).length;
  const p3pct  = phase3Ids.length ? Math.round(p3done/phase3Ids.length*100) : 0;
  const p4pct  = phase4Ids.length ? Math.round(p4done/phase4Ids.length*100) : 0;

  const pcts  = [100, 100, p3pct, p4pct];
  const cols  = ['var(--green)','var(--green)', p3pct===100?'var(--green)':'#e9c46a', 'var(--green)'];
  const badges= [
    '<span class="badge b-green">Done</span>',
    '<span class="badge b-green">Done</span>',
    p3pct===100 ? '<span class="badge b-green">Done</span>' : p3pct>0 ? `<span class="badge b-amber">${p3pct}%</span>` : '<span class="badge b-amber">In progress</span>',
    p4pct===100 ? '<span class="badge b-green">Done</span>' : p4pct>0 ? `<span class="badge b-amber">${p4pct}%</span>` : '<span class="badge b-gray">Pending</span>',
  ];
  const labels = S.phaseLabels || PHASE_LABELS;
  document.getElementById('phase-progress').innerHTML = labels.map((lbl, i) => `
    <div>
      <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:5px;">
        <span style="color:var(--muted);" contenteditable="true" onblur="savePhaseLabel(${i},this)">${lbl}</span>
        ${badges[i]}
      </div>
      <div class="progress-bar-wrap"><div class="progress-bar" style="width:${pcts[i]}%;background:${cols[i]};"></div></div>
    </div>`).join('');
}

function savePhaseLabel(i, el) {
  if (!S.phaseLabels) S.phaseLabels = [...PHASE_LABELS];
  S.phaseLabels[i] = el.textContent.trim();
  save();
}

/* ── DONUT CHART ── */
let donut = null;
function renderDonut() {
  const products = S.products || [];
  const active   = products.filter(p => p.active).length;
  const planned  = products.length - active;
  const ctx      = document.getElementById('statusDonut');
  if (donut) { donut.destroy(); donut = null; }
  donut = new Chart(ctx, {
    type:'doughnut',
    data:{ labels:['Active','Planned'], datasets:[{ data:[active||0, planned||0], backgroundColor:['#2d6a4f','#e9c46a'], borderWidth:0, hoverOffset:4 }] },
    options:{ responsive:true, maintainAspectRatio:false, cutout:'72%',
      plugins:{ legend:{display:false}, tooltip:{ callbacks:{label:c=>c.label+': '+c.parsed+' products'},
        backgroundColor:'#fff',titleColor:'#1a1917',bodyColor:'#6b6860',borderColor:'#e2e0db',borderWidth:1 } } }
  });
}

/* ── DAY CARDS ── */
const DAYS_DEFS = [
  { id:'sun', label:'Day 1', color:'#9b2226', bg:'#fce4d6', badge:'Start', bclass:'b-red',   phase:3 },
  { id:'mon', label:'Day 2', color:'#7b5e1a', bg:'#fff3cd', badge:'Day 2', bclass:'b-amber', phase:3 },
  { id:'tue', label:'Day 3', color:'#7b5e1a', bg:'#fff3cd', badge:'Day 3', bclass:'b-amber', phase:3 },
  { id:'wed', label:'Day 4', color:'#1a4b7c', bg:'#dbeafe', badge:'Day 4', bclass:'b-blue',  phase:3 },
  { id:'thu', label:'Day 5', color:'#1a4b7c', bg:'#dbeafe', badge:'Day 5', bclass:'b-blue',  phase:3 },
];
const LAUNCH_DEFS = [
  { id:'fri', label:'Pre-launch', color:'#2d6a4f', bg:'#d8f3dc', badge:'Pre-launch', bclass:'b-green', phase:4 },
  { id:'sat', label:'Launch',     color:'#2d6a4f', bg:'#d8f3dc', badge:'Launch Day', bclass:'b-green', phase:4, highlight:true },
];

function renderDays() {
  buildDayCards(DAYS_DEFS,   'days-container');
  buildDayCards(LAUNCH_DEFS, 'launch-days-container');
}

function buildDayCards(defs, containerId) {
  const container = document.getElementById(containerId);
  container.innerHTML = defs.map(d => {
    const tasks   = (S.tasks && S.tasks[d.id]) || [];
    const done    = tasks.filter((_,i) => S['task_'+d.id+'_'+i]).length;
    const pct     = tasks.length ? Math.round(done/tasks.length*100) : 0;
    const title   = (S.dayTitles && S.dayTitles[d.id]) || d.id.charAt(0).toUpperCase()+d.id.slice(1)+' — Click to rename';
    return `<div class="day-card" id="card-${d.id}" ${d.highlight?'style="border:2px solid var(--green);"':''}>
      <div class="day-mini-bar"><div class="day-mini-fill" id="mini-${d.id}" style="width:${pct}%;"></div></div>
      <div class="day-header" onclick="toggleDay('card-${d.id}')">
        <div class="day-icon" style="background:${d.bg};color:${d.color};">${d.label}</div>
        <div class="day-info">
          <div class="day-title" contenteditable="true" onclick="event.stopPropagation()" onblur="saveDayTitle('${d.id}',this)">${title}</div>
          <div class="day-sub">${done}/${tasks.length} tasks complete</div>
        </div>
        <span class="badge ${d.bclass}">${d.badge}</span>
        <span class="chevron">▾</span>
      </div>
      <div class="day-body">
        <div id="tasks-${d.id}">
          ${tasks.map((t,i) => renderTask(d.id, t, i)).join('')}
          ${tasks.length===0 ? '<div style="font-size:12px;color:var(--muted2);padding:10px 0;">No tasks yet — turn on Edit Mode and add tasks below.</div>' : ''}
        </div>
        <button class="add-task-btn" onclick="addTask('${d.id}')">+ Add task</button>
      </div>
    </div>`;
  }).join('');
}

function renderTask(dayId, text, i) {
  const checked = S['task_'+dayId+'_'+i];
  return `<div class="task" id="task-${dayId}-${i}">
    <div class="checkbox ${checked?'checked':''}" onclick="toggleTask('${dayId}',${i})"></div>
    <div class="task-text ${checked?'done':''}" contenteditable="true" onclick="event.stopPropagation()" onblur="saveTaskText('${dayId}',${i},this)">${text}</div>
    <button class="task-del-btn" onclick="deleteTask('${dayId}',${i})">×</button>
  </div>`;
}

function toggleDay(id) { document.getElementById(id).classList.toggle('open'); }

function saveDayTitle(dayId, el) {
  if (!S.dayTitles) S.dayTitles = {};
  S.dayTitles[dayId] = el.textContent.trim();
  save();
}

function toggleTask(dayId, idx) {
  const key = 'task_'+dayId+'_'+idx;
  S[key] = !S[key];
  save();
  const cb  = document.querySelector(`#task-${dayId}-${idx} .checkbox`);
  const txt = document.querySelector(`#task-${dayId}-${idx} .task-text`);
  if (cb)  cb.classList.toggle('checked', S[key]);
  if (txt) txt.classList.toggle('done',   S[key]);
  updateDayMini(dayId);
  renderPhaseProgress();
}

function saveTaskText(dayId, idx, el) {
  if (!S.tasks) S.tasks = {};
  if (!S.tasks[dayId]) S.tasks[dayId] = [];
  S.tasks[dayId][idx] = el.textContent.trim();
  save();
}

function addTask(dayId) {
  if (!S.tasks) S.tasks = {};
  if (!S.tasks[dayId]) S.tasks[dayId] = [];
  S.tasks[dayId].push('New task — click to edit');
  save();
  renderDays();
  // auto-open
  const card = document.getElementById('card-'+dayId);
  if (card) card.classList.add('open');
  // focus new task
  setTimeout(() => {
    const container = document.getElementById('tasks-'+dayId);
    if (container) {
      const tasks = container.querySelectorAll('.task-text');
      if (tasks.length) { const last = tasks[tasks.length-1]; last.focus(); document.execCommand('selectAll'); }
    }
  }, 50);
}

function deleteTask(dayId, idx) {
  if (!S.tasks || !S.tasks[dayId]) return;
  S.tasks[dayId].splice(idx, 1);
  delete S['task_'+dayId+'_'+idx];
  save();
  renderDays();
  renderPhaseProgress();
  const card = document.getElementById('card-'+dayId);
  if (card) card.classList.add('open');
}

function updateDayMini(dayId) {
  const tasks = (S.tasks && S.tasks[dayId]) || [];
  const done  = tasks.filter((_,i) => S['task_'+dayId+'_'+i]).length;
  const pct   = tasks.length ? Math.round(done/tasks.length*100) : 0;
  const mini  = document.getElementById('mini-'+dayId);
  if (mini) mini.style.width = pct+'%';
  // update subtitle
  const card = document.getElementById('card-'+dayId);
  if (card) {
    const sub = card.querySelector('.day-sub');
    if (sub) sub.textContent = done+'/'+tasks.length+' tasks complete';
  }
}

/* ── PRODUCTS ── */
const ACCENT_COLORS = ['var(--green)','var(--blue)','var(--amber)','var(--red)','var(--muted)'];

function renderProducts() {
  const products = S.products || [];
  const grid     = document.getElementById('product-grid');
  const empty    = document.getElementById('prod-empty');
  if (!products.length) {
    grid.innerHTML = '';
    empty.style.display = 'block';
  } else {
    empty.style.display = 'none';
    grid.innerHTML = products.map((p,i) => {
      const cost   = parseFloat(p.cost)   || 0;
      const price  = parseFloat(p.price)  || 0;
      const profit = price > cost ? (price - cost).toFixed(2) : '—';
      const margin = price > 0 ? Math.round((price-cost)/price*100) : 0;
      const accent = ACCENT_COLORS[i % ACCENT_COLORS.length];
      return `<div class="prod-card">
        <div class="prod-accent" style="background:${accent};"></div>
        <button class="prod-del-btn" onclick="deleteProduct(${i})">×</button>
        <div class="prod-name-wrap">
          <input class="prod-name-input" value="${escHtml(p.name||'Product name')}" onchange="saveProduct(${i},'name',this.value)" placeholder="Product name">
        </div>
        <div class="prod-row"><span class="prod-key">Supplier cost</span><span>SAR <input class="prod-num" type="number" value="${p.cost||''}" onchange="saveProduct(${i},'cost',this.value)" placeholder="0.00" min="0" step="0.01"></span></div>
        <div class="prod-row"><span class="prod-key">Selling price</span><span>SAR <input class="prod-num" type="number" value="${p.price||''}" onchange="saveProduct(${i},'price',this.value)" placeholder="0.00" min="0" step="0.01"></span></div>
        <div class="prod-profit-row"><span style="color:var(--muted);font-size:11.5px;">Profit/unit</span><span class="prod-profit-val" id="profit-${i}">~SAR ${profit}</span></div>
        <div class="prod-margin">
          <div class="margin-bar-wrap"><div class="margin-bar" id="mbar-${i}" style="width:${margin}%;"></div></div>
          <span class="margin-pct" id="mpct-${i}">${margin}%</span>
        </div>
      </div>`;
    }).join('');
  }
  renderDonut();
  updateProdCount();
}

function addProduct() {
  if (!S.products) S.products = [];
  S.products.push({ name:'', cost:'', price:'', active:false });
  save();
  renderProducts();
}

function deleteProduct(i) {
  if (!S.products) return;
  S.products.splice(i, 1);
  save();
  renderProducts();
}

function saveProduct(i, field, val) {
  if (!S.products || !S.products[i]) return;
  S.products[i][field] = val;
  save();
  // recalculate profit/margin inline
  const cost   = parseFloat(S.products[i].cost)  || 0;
  const price  = parseFloat(S.products[i].price) || 0;
  const profit = price > cost ? (price - cost).toFixed(2) : '—';
  const margin = price > 0 ? Math.round((price-cost)/price*100) : 0;
  const pEl = document.getElementById('profit-'+i);
  const mBar= document.getElementById('mbar-'+i);
  const mPct= document.getElementById('mpct-'+i);
  if (pEl) pEl.textContent = '~SAR '+profit;
  if (mBar) mBar.style.width = margin+'%';
  if (mPct) mPct.textContent = margin+'%';
  updateProdCount();
}

function updateProdCount() {
  const count = (S.products||[]).length;
  const el = document.querySelector('[onblur*="kpi_products"]');
  if (el && !S.kpi_products) el.textContent = count || '—';
}

function escHtml(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

/* ── BUNDLES ── */
function renderBundles() {
  const bundles = S.bundles || [];
  const wrap    = document.getElementById('bundle-rows');
  const empty   = document.getElementById('bundle-empty');
  if (!bundles.length) {
    wrap.innerHTML = '';
    empty.style.display = 'block';
    return;
  }
  empty.style.display = 'none';
  wrap.innerHTML = bundles.map((b,i) => `
    <div class="bundle-row">
      <div class="bundle-cell">
        <input class="bundle-input" value="${escHtml(b.name||'')}" placeholder="Bundle name" onchange="saveBundle(${i},'name',this.value)">
        <div style="font-size:11px;color:var(--muted2);margin-top:2px;">
          <input class="bundle-input" style="font-size:11px;color:var(--muted2);" value="${escHtml(b.contents||'')}" placeholder="Contents" onchange="saveBundle(${i},'contents',this.value)">
        </div>
      </div>
      <div class="bundle-cell center"><input class="bundle-input" style="text-align:center;" type="text" value="${escHtml(b.price||'')}" placeholder="—" onchange="saveBundle(${i},'price',this.value)"></div>
      <div class="bundle-cell center"><input class="bundle-input" style="text-align:center;" type="text" value="${escHtml(b.cost||'')}" placeholder="—" onchange="saveBundle(${i},'cost',this.value)"></div>
      <div class="bundle-cell good"><input class="bundle-input" style="color:var(--green);font-weight:500;text-align:center;" type="text" value="${escHtml(b.profit||'')}" placeholder="—" onchange="saveBundle(${i},'profit',this.value)"></div>
      <button class="bundle-del-btn" onclick="deleteBundle(${i})">×</button>
    </div>`).join('');
}

function addBundle() {
  if (!S.bundles) S.bundles = [];
  S.bundles.push({ name:'', contents:'', price:'', cost:'', profit:'' });
  save(); renderBundles();
}
function deleteBundle(i) { S.bundles.splice(i,1); save(); renderBundles(); }
function saveBundle(i, field, val) { S.bundles[i][field] = val; save(); }

/* ── ROI CALCULATOR ── */
const PLATFORMS = {
  snapchat:  { cpc:[0.8,1.5],  cvr:[1.5,3.5], note:'Best for Saudi Arabia — highest daily active users among Saudi millennials.' },
  instagram: { cpc:[1.5,3.0],  cvr:[1.0,2.5], note:'Strong for visual products — reels and before/after content convert well.' },
  google:    { cpc:[2.0,4.0],  cvr:[3.0,5.0], note:'Best ROI for high-intent buyers already searching for your product.' },
  tiktok:    { cpc:[0.5,1.2],  cvr:[0.5,2.0], note:'Growing fast — requires short engaging video of product in use.' },
};

function updateROIInputs() {
  if (S.budget)    document.getElementById('roi-budget').value    = S.budget;
  if (S.aov)       document.getElementById('roi-aov').value       = S.aov;
  if (S.profitPer) document.getElementById('roi-profit-per').value= S.profitPer;
}

function calcROI() {
  const budget = parseFloat(document.getElementById('roi-budget').value)     || 0;
  const aov    = parseFloat(document.getElementById('roi-aov').value)        || 0;
  const profPer= parseFloat(document.getElementById('roi-profit-per').value) || 0;
  const p      = PLATFORMS[document.getElementById('platform-select').value];

  if (!budget || !aov || !profPer) {
    document.getElementById('roi-results').innerHTML = `<div class="roi-title">Fill in your numbers above</div><div style="font-size:12px;color:var(--muted);line-height:1.8;">Enter your marketing budget, average order value, and profit per order to see projected results.</div>`;
    return;
  }
  S.budget    = budget;
  S.aov       = aov;
  S.profitPer = profPer;
  save();

  const minClicks = Math.round(budget / p.cpc[1]);
  const maxClicks = Math.round(budget / p.cpc[0]);
  const minOrders = Math.round(minClicks * p.cvr[0] / 100);
  const maxOrders = Math.round(maxClicks * p.cvr[1] / 100);
  const minRev    = minOrders * aov;
  const maxRev    = maxOrders * aov;
  const minNet    = minOrders * profPer - budget;
  const maxNet    = maxOrders * profPer - budget;
  const breakEven = Math.ceil(budget / profPer);
  const isProfit  = maxNet > 0;

  document.getElementById('roi-results').innerHTML = `
    <div class="roi-title">Projected results</div>
    <div class="roi-row"><span class="roi-label">Estimated clicks</span><span class="roi-val">${minClicks.toLocaleString()} – ${maxClicks.toLocaleString()} visitors</span></div>
    <div class="roi-row"><span class="roi-label">Expected orders</span><span class="roi-val">${minOrders} – ${maxOrders} orders</span></div>
    <div class="roi-row"><span class="roi-label">Expected revenue</span><span class="roi-val">SAR ${minRev.toLocaleString()} – ${maxRev.toLocaleString()}</span></div>
    <div class="roi-row"><span class="roi-label">Net after ad spend</span><span class="roi-val" style="color:${isProfit?'var(--green)':'var(--red)'};">SAR ${minNet.toLocaleString()} – ${maxNet.toLocaleString()}</span></div>
    <div class="roi-row"><span class="roi-label">Break-even orders</span><span class="roi-val">${breakEven} orders needed</span></div>
    <div class="roi-row" style="border:none;"><span class="roi-label">Likely outcome</span><span class="badge ${isProfit?'b-green':'b-amber'}">${isProfit?'Profitable':'Break even / slight loss'}</span></div>
    <div style="font-size:11.5px;color:var(--muted);line-height:1.6;margin-top:10px;padding-top:10px;border-top:1px solid var(--surface2);">${p.note}</div>`;
}

let roiChart = null;
function buildROIChart() {
  const ctx = document.getElementById('roiChart');
  if (!ctx) return;
  if (roiChart) { roiChart.destroy(); roiChart = null; }
  const budget  = parseFloat(document.getElementById('roi-budget').value) || 2000;
  const profPer = parseFloat(document.getElementById('roi-profit-per').value) || 12;
  const data = Object.entries(PLATFORMS).map(([key, p]) => {
    const minC = Math.round(budget/p.cpc[1]);
    const maxC = Math.round(budget/p.cpc[0]);
    return { label: key.charAt(0).toUpperCase()+key.slice(1), minO: Math.round(minC*p.cvr[0]/100), maxO: Math.round(maxC*p.cvr[1]/100) };
  });
  const colors = ['#FFBA08','#E1306C','#4285F4','#2d3436'];
  roiChart = new Chart(ctx, {
    type:'bar',
    data:{ labels:data.map(d=>d.label), datasets:[
      { label:'Min orders', data:data.map(d=>d.minO), backgroundColor:colors.map(c=>c+'66'), borderRadius:4, borderSkipped:false },
      { label:'Max orders', data:data.map(d=>d.maxO), backgroundColor:colors,               borderRadius:4, borderSkipped:false },
    ]},
    options:{ responsive:true, maintainAspectRatio:false,
      plugins:{ legend:{display:false}, tooltip:{ callbacks:{label:c=>c.dataset.label+': '+c.parsed.y+' orders'},
        backgroundColor:'#fff',titleColor:'#1a1917',bodyColor:'#6b6860',borderColor:'#e2e0db',borderWidth:1 } },
      scales:{ x:{ticks:{color:'#6b6860',font:{size:12,family:'Inter'}},grid:{display:false}},
               y:{ticks:{color:'#6b6860',font:{size:11,family:'Inter'},callback:v=>v+' orders'},grid:{color:'rgba(0,0,0,.05)'}} } }
  });
}

/* ── MILESTONES ── */
const MILESTONE_DEFS = [
  { id:'m1', barId:'orders-bar', labelId:'orders-label', pct:50,  label:'Half way on orders' },
  { id:'m2', barId:'orders-bar', labelId:'orders-label', pct:100, label:'Orders target hit' },
  { id:'m3', barId:'rev-bar',    labelId:'rev-label',    pct:50,  label:'Half way on revenue' },
  { id:'m4', barId:'rev-bar',    labelId:'rev-label',    pct:100, label:'Revenue target hit' },
  { id:'m5', barId:'rev2-bar',   labelId:'rev2-label',   pct:60,  label:'First reviews in' },
  { id:'m6', barId:'rev2-bar',   labelId:'rev2-label',   pct:100, label:'Review target hit' },
];

function restoreMilestones() {
  document.getElementById('milestone-btns').innerHTML = MILESTONE_DEFS.map(m => {
    const done = S['ms_'+m.id];
    return `<button class="milestone-btn ${done?'done-btn':''}" id="mbtn-${m.id}" onclick="hitMilestone('${m.id}')" ${done?'disabled':''}>${m.label}</button>`;
  }).join('');
  MILESTONE_DEFS.forEach(m => {
    if (S['ms_'+m.id]) { const b = document.getElementById(m.barId); if (b) b.style.width = m.pct+'%'; }
  });
}

function hitMilestone(id) {
  const m = MILESTONE_DEFS.find(x => x.id === id);
  if (!m) return;
  const bar = document.getElementById(m.barId);
  if (bar) bar.style.width = m.pct+'%';
  const btn = document.getElementById('mbtn-'+id);
  if (btn) { btn.classList.add('done-btn'); btn.disabled = true; }
  S['ms_'+id] = true;
  save();
  toast('Milestone reached: '+m.label+' ✓');
}

/* ── RESET ── */
function confirmReset() {
  if (confirm('Reset all data? This will clear everything and restart the setup wizard.')) {
    localStorage.removeItem(KEY);
    location.reload();
  }
}

/* ── INIT ── */
if (!S.setupDone) {
  document.getElementById('setup-modal').classList.remove('hidden');
} else {
  document.getElementById('setup-modal').classList.add('hidden');
  applyState();
}
</script>
